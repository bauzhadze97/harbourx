# ── Telegram ──────────────────────────────────────────────────────────────
# @BotFather -> /newbot (or /revoke to rotate an exposed token)
BOT_TOKEN=123456:REPLACE_ME
# Telegram user IDs allowed to use the bot's admin commands (comma separated).
# Find yours by sending /id to the bot.
BOT_ADMIN_IDS=
# Public channel the shop posts reviews to. Either @username or -100... id.
# The bot must be an administrator of that channel.
REVIEW_CHANNEL=@testchanelll11

# ── Admin panel ───────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
# Leave blank on first run and the panel prints a generated password once.
ADMIN_PASSWORD=
# 64 hex chars. Generate with: python3 -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
# Set to 1 once the panel is served over HTTPS (cookies get the Secure flag).
COOKIE_SECURE=0

# ── NOWPayments ───────────────────────────────────────────────────────────
# https://account.nowpayments.io -> Settings -> Payments
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# 'auto' uses the keys above; 'demo' hands out obviously fake addresses so the
# top-up flow can be walked through offline.
PAYMENTS_MODE=auto
# Public URL that NOWPayments can reach for IPN callbacks, e.g. an ngrok or
# Cloudflare tunnel in development: https://xxxx.ngrok-free.app
PUBLIC_BASE_URL=http://127.0.0.1:8791
# Currency the shop prices in, and the crypto users top up with.
SHOP_CURRENCY=GEL
DEFAULT_PAY_CURRENCY=usdttrc20

# ── Server ────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8791
DB_PATH=data/shop.db
